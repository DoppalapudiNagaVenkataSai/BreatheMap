APP_ENV=development
APP_SECRET=replace-with-a-random-32-char-secret-string
LOG_LEVEL=INFO
STORE_BACKEND=memory
DEMO_MODE=allow

# Open-Meteo & Nominatim
NOMINATIM_CONTACT_EMAIL=contact@example.com

# Routing
ORS_API_KEY=

# AI Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENABLED=false
GEMINI_DAILY_LIMIT=18
GEMINI_RPM_LIMIT=4
ASSISTANT_AI_PER_IP_PER_DAY=5

# Firebase (production)
FIREBASE_PROJECT_ID=
FIRESTORE_CREDENTIALS_B64=

# Administration
ADMIN_TOKEN=
